@model IEnumerable<AdoNetApp.Models.Student>
@{
    ViewData["Title"] = "Student List";
}

<h2>Student List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Course</th>
            <th>Semester</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentName</td>
                <td>@student.Course</td>
                <td>@student.Semester</td>
            </tr>
        }
    </tbody>
</table>
